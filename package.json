{
  "name": "web-extension",
  "version": "3.0.0",
  "description": "Scaffold and build cross-browser extensions with esbuild. One manifest.json, no bundler config.",
  "type": "module",
  "bin": {
    "web-extension": "dist/index.js"
  },
  "files": [
    "dist",
    "schemas",
    "AI.md",
    "DEVELOPER.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node test/e2e/run.mjs"
  },
  "keywords": [
    "webextension",
    "chrome-extension",
    "firefox-addon",
    "safari-extension",
    "esbuild",
    "scaffold",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TiwPhiraphan/web-extension.git"
  },
  "bugs": {
    "url": "https://github.com/TiwPhiraphan/web-extension/issues"
  },
  "homepage": "https://github.com/TiwPhiraphan/web-extension#readme",
  "author": "TiwPhiraphan",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "playwright": "^1.65.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "webextension-polyfill": "^0.12.0"
  }
}
