{
  "name": "web-extension",
  "version": "0.1.0",
  "description": "Scaffold cross-browser extensions with Vite and CRXJS",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "web-extension": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:smoke": "bun test-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "chrome-extension",
    "firefox-addon",
    "safari-extension",
    "webextension",
    "crxjs",
    "vite",
    "scaffold",
    "cli"
  ],
  "author": "TiwPhiraphan",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^9.0.0",
    "typescript": "^5.8.2",
    "vitest": "^5.1.0"
  }
}

