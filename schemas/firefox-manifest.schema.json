{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Firefox WebExtension manifest",
  "description": "MV2 and MV3. Firefox uses background.scripts (event pages), not service workers.",
  "type": "object",
  "required": [
    "manifest_version",
    "name",
    "version"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "manifest_version": {
      "enum": [
        2,
        3
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "short_name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "description": "Toolkit version format (e.g. 1.0.3, 2.0.0beta1)"
    },
    "version_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object"
        }
      ]
    },
    "homepage_url": {
      "type": "string",
      "format": "uri"
    },
    "default_locale": {
      "type": "string"
    },
    "icons": {
      "type": "object",
      "description": "Map of size -> path, e.g. { \"16\": \"icons/16.png\" }",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "string"
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "enum": [
              "activeTab",
              "alarms",
              "background",
              "bookmarks",
              "browserSettings",
              "browsingData",
              "captivePortal",
              "clipboardRead",
              "clipboardWrite",
              "contextMenus",
              "contextualIdentities",
              "cookies",
              "declarativeNetRequest",
              "declarativeNetRequestFeedback",
              "declarativeNetRequestWithHostAccess",
              "devtools",
              "dns",
              "downloads",
              "downloads.open",
              "find",
              "geolocation",
              "history",
              "identity",
              "idle",
              "management",
              "menus",
              "menus.overrideContext",
              "nativeMessaging",
              "notifications",
              "pkcs11",
              "privacy",
              "proxy",
              "scripting",
              "search",
              "sessions",
              "storage",
              "tabHide",
              "tabs",
              "theme",
              "topSites",
              "unlimitedStorage",
              "userScripts",
              "webNavigation",
              "webRequest",
              "webRequestBlocking",
              "webRequestFilterResponse",
              "webRequestFilterResponse.serviceWorkerScript"
            ]
          },
          {
            "type": "string"
          }
        ]
      },
      "uniqueItems": true
    },
    "optional_permissions": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "enum": [
              "activeTab",
              "alarms",
              "background",
              "bookmarks",
              "browserSettings",
              "browsingData",
              "captivePortal",
              "clipboardRead",
              "clipboardWrite",
              "contextMenus",
              "contextualIdentities",
              "cookies",
              "declarativeNetRequest",
              "declarativeNetRequestFeedback",
              "declarativeNetRequestWithHostAccess",
              "devtools",
              "dns",
              "downloads",
              "downloads.open",
              "find",
              "geolocation",
              "history",
              "identity",
              "idle",
              "management",
              "menus",
              "menus.overrideContext",
              "nativeMessaging",
              "notifications",
              "pkcs11",
              "privacy",
              "proxy",
              "scripting",
              "search",
              "sessions",
              "storage",
              "tabHide",
              "tabs",
              "theme",
              "topSites",
              "unlimitedStorage",
              "userScripts",
              "webNavigation",
              "webRequest",
              "webRequestBlocking",
              "webRequestFilterResponse",
              "webRequestFilterResponse.serviceWorkerScript"
            ]
          },
          {
            "type": "string"
          }
        ]
      },
      "uniqueItems": true
    },
    "host_permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "MV3: match patterns the extension may access"
    },
    "optional_host_permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_scripts": {
      "type": "array",
      "description": "Scripts/styles injected into matching pages",
      "items": {
        "type": "object",
        "required": [
          "matches"
        ],
        "properties": {
          "matches": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(<all_urls>|(\\*|https?|wss?|ftp|file)://(\\*|\\*\\.[^/*]+|[^/*]*)/.*)$",
              "description": "Match pattern, e.g. https://*.example.com/* or <all_urls>"
            }
          },
          "exclude_matches": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(<all_urls>|(\\*|https?|wss?|ftp|file)://(\\*|\\*\\.[^/*]+|[^/*]*)/.*)$",
              "description": "Match pattern, e.g. https://*.example.com/* or <all_urls>"
            }
          },
          "include_globs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclude_globs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "js": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "css": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "run_at": {
            "enum": [
              "document_start",
              "document_end",
              "document_idle"
            ],
            "default": "document_idle"
          },
          "all_frames": {
            "type": "boolean"
          },
          "match_about_blank": {
            "type": "boolean"
          },
          "match_origin_as_fallback": {
            "type": "boolean"
          },
          "world": {
            "enum": [
              "ISOLATED",
              "MAIN"
            ],
            "default": "ISOLATED",
            "description": "MAIN runs in the page's JS context (can patch XHR/fetch, no chrome.* APIs)"
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "suggested_key": {
            "type": "object",
            "properties": {
              "default": {
                "type": "string"
              },
              "mac": {
                "type": "string"
              },
              "windows": {
                "type": "string"
              },
              "linux": {
                "type": "string"
              },
              "chromeos": {
                "type": "string"
              },
              "android": {
                "type": "string"
              },
              "ios": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "declarative_net_request": {
      "type": "object",
      "properties": {
        "rule_resources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "enabled",
              "path"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "path": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "devtools_page": {
      "type": "string"
    },
    "update_url": {
      "type": "string",
      "format": "uri"
    },
    "browser_specific_settings": {
      "type": "object",
      "properties": {
        "gecko": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Add-on ID, e.g. addon@example.com or {uuid}. Required for MV3 / signing."
            },
            "strict_min_version": {
              "type": "string"
            },
            "strict_max_version": {
              "type": "string"
            },
            "update_url": {
              "type": "string",
              "format": "uri"
            },
            "data_collection_permissions": {
              "type": "object",
              "description": "Declare what data the extension collects/transmits",
              "properties": {
                "required": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "enum": [
                          "authenticationInfo",
                          "bookmarksInfo",
                          "browsingActivity",
                          "financialAndPaymentInfo",
                          "healthInfo",
                          "locationInfo",
                          "personalCommunications",
                          "personallyIdentifyingInfo",
                          "searchTerms",
                          "technicalAndInteraction",
                          "websiteActivity",
                          "websiteContent",
                          "none"
                        ]
                      },
                      {
                        "type": "string"
                      }
                    ]
                  }
                },
                "optional": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "enum": [
                          "authenticationInfo",
                          "bookmarksInfo",
                          "browsingActivity",
                          "financialAndPaymentInfo",
                          "healthInfo",
                          "locationInfo",
                          "personalCommunications",
                          "personallyIdentifyingInfo",
                          "searchTerms",
                          "technicalAndInteraction",
                          "websiteActivity",
                          "websiteContent",
                          "none"
                        ]
                      },
                      {
                        "type": "string"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "gecko_android": {
          "type": "object",
          "properties": {
            "strict_min_version": {
              "type": "string"
            },
            "strict_max_version": {
              "type": "string"
            }
          }
        }
      }
    },
    "applications": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Add-on ID, e.g. addon@example.com or {uuid}. Required for MV3 / signing."
        },
        "strict_min_version": {
          "type": "string"
        },
        "strict_max_version": {
          "type": "string"
        },
        "update_url": {
          "type": "string",
          "format": "uri"
        },
        "data_collection_permissions": {
          "type": "object",
          "description": "Declare what data the extension collects/transmits",
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "enum": [
                      "authenticationInfo",
                      "bookmarksInfo",
                      "browsingActivity",
                      "financialAndPaymentInfo",
                      "healthInfo",
                      "locationInfo",
                      "personalCommunications",
                      "personallyIdentifyingInfo",
                      "searchTerms",
                      "technicalAndInteraction",
                      "websiteActivity",
                      "websiteContent",
                      "none"
                    ]
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            },
            "optional": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "enum": [
                      "authenticationInfo",
                      "bookmarksInfo",
                      "browsingActivity",
                      "financialAndPaymentInfo",
                      "healthInfo",
                      "locationInfo",
                      "personalCommunications",
                      "personallyIdentifyingInfo",
                      "searchTerms",
                      "technicalAndInteraction",
                      "websiteActivity",
                      "websiteContent",
                      "none"
                    ]
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            }
          }
        }
      },
      "description": "Deprecated alias of browser_specific_settings.gecko"
    },
    "background": {
      "type": "object",
      "properties": {
        "scripts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "page": {
          "type": "string"
        },
        "persistent": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "classic",
            "module"
          ]
        },
        "service_worker": {
          "type": "string",
          "description": "Ignored by Firefox; allowed for cross-browser manifests"
        }
      }
    },
    "action": {
      "type": "object",
      "properties": {
        "default_icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "description": "Map of size -> path, e.g. { \"16\": \"icons/16.png\" }",
              "patternProperties": {
                "^[0-9]+$": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "default_title": {
          "type": "string"
        },
        "default_popup": {
          "type": "string"
        },
        "browser_style": {
          "type": "boolean"
        },
        "default_area": {
          "enum": [
            "navbar",
            "menupanel",
            "tabstrip",
            "personaltoolbar"
          ]
        },
        "theme_icons": {
          "type": "array"
        }
      }
    },
    "browser_action": {
      "type": "object",
      "properties": {
        "default_icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "description": "Map of size -> path, e.g. { \"16\": \"icons/16.png\" }",
              "patternProperties": {
                "^[0-9]+$": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "default_title": {
          "type": "string"
        },
        "default_popup": {
          "type": "string"
        },
        "browser_style": {
          "type": "boolean"
        },
        "default_area": {
          "type": "string"
        },
        "theme_icons": {
          "type": "array"
        }
      }
    },
    "page_action": {
      "type": "object",
      "properties": {
        "default_icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "description": "Map of size -> path, e.g. { \"16\": \"icons/16.png\" }",
              "patternProperties": {
                "^[0-9]+$": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "default_title": {
          "type": "string"
        },
        "default_popup": {
          "type": "string"
        },
        "browser_style": {
          "type": "boolean"
        },
        "show_matches": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(<all_urls>|(\\*|https?|wss?|ftp|file)://(\\*|\\*\\.[^/*]+|[^/*]*)/.*)$",
            "description": "Match pattern, e.g. https://*.example.com/* or <all_urls>"
          }
        },
        "hide_matches": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(<all_urls>|(\\*|https?|wss?|ftp|file)://(\\*|\\*\\.[^/*]+|[^/*]*)/.*)$",
            "description": "Match pattern, e.g. https://*.example.com/* or <all_urls>"
          }
        },
        "pinned": {
          "type": "boolean"
        }
      }
    },
    "sidebar_action": {
      "type": "object",
      "properties": {
        "default_title": {
          "type": "string"
        },
        "default_panel": {
          "type": "string"
        },
        "default_icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "description": "Map of size -> path, e.g. { \"16\": \"icons/16.png\" }",
              "patternProperties": {
                "^[0-9]+$": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "open_at_install": {
          "type": "boolean"
        },
        "browser_style": {
          "type": "boolean"
        }
      }
    },
    "options_ui": {
      "type": "object",
      "required": [
        "page"
      ],
      "properties": {
        "page": {
          "type": "string"
        },
        "open_in_tab": {
          "type": "boolean"
        },
        "browser_style": {
          "type": "boolean"
        }
      }
    },
    "web_accessible_resources": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "resources"
            ],
            "properties": {
              "resources": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "matches": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(<all_urls>|(\\*|https?|wss?|ftp|file)://(\\*|\\*\\.[^/*]+|[^/*]*)/.*)$",
                  "description": "Match pattern, e.g. https://*.example.com/* or <all_urls>"
                }
              },
              "extension_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "use_dynamic_url": {
                "type": "boolean"
              }
            }
          }
        ]
      }
    },
    "content_security_policy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "extension_pages": {
              "type": "string"
            }
          }
        }
      ]
    },
    "incognito": {
      "enum": [
        "spanning",
        "not_allowed",
        "split"
      ]
    },
    "developer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "theme": {
      "type": "object"
    },
    "protocol_handlers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "protocol",
          "name",
          "uriTemplate"
        ],
        "properties": {
          "protocol": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "uriTemplate": {
            "type": "string"
          }
        }
      }
    },
    "chrome_settings_overrides": {
      "type": "object"
    },
    "chrome_url_overrides": {
      "type": "object",
      "properties": {
        "newtab": {
          "type": "string"
        },
        "bookmarks": {
          "type": "string"
        },
        "history": {
          "type": "string"
        }
      }
    },
    "omnibox": {
      "type": "object",
      "required": [
        "keyword"
      ],
      "properties": {
        "keyword": {
          "type": "string"
        }
      }
    },
    "user_scripts": {
      "type": "object",
      "properties": {
        "api_script": {
          "type": "string"
        }
      }
    },
    "dictionaries": {
      "type": "object"
    },
    "langpack_id": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
