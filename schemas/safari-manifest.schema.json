{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Safari Web Extension manifest",
  "description": "Same manifest.json format; wrapped in an Xcode project. Supports only a subset of keys/APIs (best-effort list).",
  "type": "object",
  "required": [
    "manifest_version",
    "name",
    "version"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "manifest_version": {
      "enum": [
        2,
        3
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "short_name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "version_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object"
        }
      ]
    },
    "homepage_url": {
      "type": "string",
      "format": "uri"
    },
    "default_locale": {
      "type": "string"
    },
    "icons": {
      "type": "object",
      "description": "Map of size -> path, e.g. { \"16\": \"icons/16.png\" }",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "string"
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "enum": [
              "activeTab",
              "alarms",
              "clipboardWrite",
              "contextMenus",
              "cookies",
              "declarativeNetRequest",
              "declarativeNetRequestFeedback",
              "declarativeNetRequestWithHostAccess",
              "menus",
              "nativeMessaging",
              "notifications",
              "scripting",
              "storage",
              "tabs",
              "unlimitedStorage",
              "webNavigation",
              "webRequest"
            ]
          },
          {
            "type": "string"
          }
        ]
      },
      "uniqueItems": true
    },
    "optional_permissions": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "enum": [
              "activeTab",
              "alarms",
              "clipboardWrite",
              "contextMenus",
              "cookies",
              "declarativeNetRequest",
              "declarativeNetRequestFeedback",
              "declarativeNetRequestWithHostAccess",
              "menus",
              "nativeMessaging",
              "notifications",
              "scripting",
              "storage",
              "tabs",
              "unlimitedStorage",
              "webNavigation",
              "webRequest"
            ]
          },
          {
            "type": "string"
          }
        ]
      },
      "uniqueItems": true
    },
    "host_permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "MV3: match patterns the extension may access"
    },
    "optional_host_permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_scripts": {
      "type": "array",
      "description": "Scripts/styles injected into matching pages",
      "items": {
        "type": "object",
        "required": [
          "matches"
        ],
        "properties": {
          "matches": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(<all_urls>|(\\*|https?|wss?|ftp|file)://(\\*|\\*\\.[^/*]+|[^/*]*)/.*)$",
              "description": "Match pattern, e.g. https://*.example.com/* or <all_urls>"
            }
          },
          "exclude_matches": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(<all_urls>|(\\*|https?|wss?|ftp|file)://(\\*|\\*\\.[^/*]+|[^/*]*)/.*)$",
              "description": "Match pattern, e.g. https://*.example.com/* or <all_urls>"
            }
          },
          "include_globs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclude_globs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "js": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "css": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "run_at": {
            "enum": [
              "document_start",
              "document_end",
              "document_idle"
            ],
            "default": "document_idle"
          },
          "all_frames": {
            "type": "boolean"
          },
          "match_about_blank": {
            "type": "boolean"
          },
          "match_origin_as_fallback": {
            "type": "boolean"
          },
          "world": {
            "enum": [
              "ISOLATED",
              "MAIN"
            ],
            "default": "ISOLATED",
            "description": "MAIN runs in the page's JS context (can patch XHR/fetch, no chrome.* APIs)"
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "suggested_key": {
            "type": "object",
            "properties": {
              "default": {
                "type": "string"
              },
              "mac": {
                "type": "string"
              },
              "windows": {
                "type": "string"
              },
              "linux": {
                "type": "string"
              },
              "chromeos": {
                "type": "string"
              },
              "android": {
                "type": "string"
              },
              "ios": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "declarative_net_request": {
      "type": "object",
      "properties": {
        "rule_resources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "enabled",
              "path"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "path": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "devtools_page": {
      "type": "string"
    },
    "update_url": {
      "type": "string",
      "format": "uri"
    },
    "browser_specific_settings": {
      "type": "object",
      "properties": {
        "safari": {
          "type": "object",
          "properties": {
            "strict_min_version": {
              "type": "string"
            },
            "strict_max_version": {
              "type": "string"
            }
          }
        }
      }
    },
    "background": {
      "type": "object",
      "properties": {
        "service_worker": {
          "type": "string"
        },
        "scripts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "page": {
          "type": "string"
        },
        "persistent": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "classic",
            "module"
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "properties": {
        "default_icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "description": "Map of size -> path, e.g. { \"16\": \"icons/16.png\" }",
              "patternProperties": {
                "^[0-9]+$": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "default_title": {
          "type": "string"
        },
        "default_popup": {
          "type": "string"
        }
      }
    },
    "browser_action": {
      "type": "object",
      "properties": {
        "default_icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "description": "Map of size -> path, e.g. { \"16\": \"icons/16.png\" }",
              "patternProperties": {
                "^[0-9]+$": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "default_title": {
          "type": "string"
        },
        "default_popup": {
          "type": "string"
        }
      }
    },
    "page_action": {
      "type": "object",
      "properties": {
        "default_icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "description": "Map of size -> path, e.g. { \"16\": \"icons/16.png\" }",
              "patternProperties": {
                "^[0-9]+$": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "default_title": {
          "type": "string"
        },
        "default_popup": {
          "type": "string"
        }
      }
    },
    "options_ui": {
      "type": "object",
      "required": [
        "page"
      ],
      "properties": {
        "page": {
          "type": "string"
        },
        "open_in_tab": {
          "type": "boolean"
        }
      }
    },
    "options_page": {
      "type": "string"
    },
    "web_accessible_resources": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "resources"
            ],
            "properties": {
              "resources": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "matches": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(<all_urls>|(\\*|https?|wss?|ftp|file)://(\\*|\\*\\.[^/*]+|[^/*]*)/.*)$",
                  "description": "Match pattern, e.g. https://*.example.com/* or <all_urls>"
                }
              },
              "extension_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "use_dynamic_url": {
                "type": "boolean"
              }
            }
          }
        ]
      }
    },
    "content_security_policy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "extension_pages": {
              "type": "string"
            }
          }
        }
      ]
    },
    "chrome_url_overrides": {
      "type": "object",
      "properties": {
        "newtab": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": true
}
